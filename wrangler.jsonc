{
  "name": "jumatna",
  "compatibility_date": "2026-11-01",
  // السيرفر الصغير بتاع المكالمات (worker/index.js) بيرد على /api/... بس، والباقي الموقع العادي
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // دول مش سريين (موجودين أصلًا في كود الموقع)، والمفاتيح السرية بتتحط في إعدادات Cloudflare
  "vars": {
    "SUPABASE_URL": "https://ckesftkcbcbrqaitgcfi.supabase.co",
    "SUPABASE_KEY": "sb_publishable_iA5UO1eyte31yIzclUDkjQ_vtAOHY0F"
  }
}
